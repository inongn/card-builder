{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "primitives.schema.json",
  "title": "Activity Mechanic Primitives",
  "description": "Reusable JSON Schema primitive definitions for D&D 5e / custom RPG activity mechanics.",
  "$defs": {
    "NumberOrExpression": {
      "oneOf": [
        { "type": "number" },
        { "type": "string" }
      ]
    },
    "DiceFormula": {
      "type": "object",
      "properties": {
        "count": { "$ref": "#/$defs/NumberOrExpression" },
        "sides": { "$ref": "#/$defs/NumberOrExpression" },
        "bonus": { "$ref": "#/$defs/NumberOrExpression" },
        "label": { "type": "string" }
      },
      "required": ["count", "sides"],
      "additionalProperties": false
    },
    "DamageEntry": {
      "type": "object",
      "properties": {
        "dice": {
          "oneOf": [
            { "$ref": "#/$defs/DiceFormula" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/DiceFormula" }
            }
          ]
        },
        "type": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "text": { "type": "string" },
        "condition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "HealingEntry": {
      "type": "object",
      "properties": {
        "dice": {
          "oneOf": [
            { "$ref": "#/$defs/DiceFormula" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/DiceFormula" }
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["hitPoints", "tempHitPoints"]
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TargetSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["single", "multi", "aoe", "self", "touch"]
        },
        "count": { "$ref": "#/$defs/NumberOrExpression" },
        "aoe": {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "enum": ["sphere", "cube", "cone", "cylinder", "line", "emanation"]
            },
            "size": { "$ref": "#/$defs/NumberOrExpression" },
            "height": { "$ref": "#/$defs/NumberOrExpression" }
          },
          "required": ["shape", "size"],
          "additionalProperties": false
        },
        "range": { "$ref": "#/$defs/NumberOrExpression" }
      },
      "additionalProperties": false
    },
    "AttackSpec": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["melee", "ranged"]
        },
        "type": {
          "type": "string",
          "enum": ["spell", "weapon", "unarmed"]
        },
        "bonus": { "$ref": "#/$defs/NumberOrExpression" }
      },
      "required": ["classification", "type"],
      "additionalProperties": false
    },
    "SaveOutcome": {
      "type": "object",
      "properties": {
        "damage": {
          "oneOf": [
            { "$ref": "#/$defs/DamageEntry" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/DamageEntry" }
            }
          ]
        },
        "text": { "type": "string" },
        "condition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SaveSpec": {
      "type": "object",
      "properties": {
        "ability": {
          "type": "string",
          "enum": ["str", "dex", "con", "int", "wis", "cha"]
        },
        "dc": { "$ref": "#/$defs/NumberOrExpression" },
        "failure": { "$ref": "#/$defs/SaveOutcome" },
        "success": { "$ref": "#/$defs/SaveOutcome" }
      },
      "required": ["ability"],
      "additionalProperties": false
    },
    "ScalingEntry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["spellSlot", "characterLevel"]
        },
        "base": { "$ref": "#/$defs/NumberOrExpression" },
        "damageBonus": { "$ref": "#/$defs/DiceFormula" },
        "countBonus": { "$ref": "#/$defs/NumberOrExpression" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
