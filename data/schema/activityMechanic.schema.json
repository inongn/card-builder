{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "activityMechanic.schema.json",
  "title": "Activity Mechanic Schema",
  "description": "JSON Schema for schematized D&D 5e / custom RPG activity mechanics.",
  "type": "object",
  "anyOf": [
    { "$ref": "#/$defs/SinglePatternBlock" },
    { "$ref": "#/$defs/MultiBlockMechanic" }
  ],
  "$defs": {
    "AttackPatternBlock": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "trigger": { "$ref": "primitives.schema.json#/$defs/Trigger" },
        "target": { "$ref": "primitives.schema.json#/$defs/TargetSpec" },
        "scaling": { "$ref": "primitives.schema.json#/$defs/ScalingEntry" },
        "text": { "type": "string" },
        "reliable": { "type": "boolean" },
        "upcast": { "$ref": "primitives.schema.json#/$defs/UpcastSpec" },
        "downcast": { "$ref": "primitives.schema.json#/$defs/DowncastSpec" },
        "repeat": { "$ref": "primitives.schema.json#/$defs/RepeatSpec" },
        "pattern": { "type": "string", "const": "attack" },
        "attack": { "$ref": "primitives.schema.json#/$defs/AttackSpec" },
        "hit": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "miss": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "crit": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "hitOrMiss": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "damage": { "$ref": "primitives.schema.json#/$defs/PayloadList" }
      },
      "required": ["pattern", "attack"],
      "additionalProperties": false
    },
    "SavePatternBlock": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "trigger": { "$ref": "primitives.schema.json#/$defs/Trigger" },
        "target": { "$ref": "primitives.schema.json#/$defs/TargetSpec" },
        "scaling": { "$ref": "primitives.schema.json#/$defs/ScalingEntry" },
        "text": { "type": "string" },
        "reliable": { "type": "boolean" },
        "upcast": { "$ref": "primitives.schema.json#/$defs/UpcastSpec" },
        "downcast": { "$ref": "primitives.schema.json#/$defs/DowncastSpec" },
        "repeat": { "$ref": "primitives.schema.json#/$defs/RepeatSpec" },
        "pattern": { "type": "string", "const": "save" },
        "save": { "$ref": "primitives.schema.json#/$defs/SaveSpec" },
        "failureOrSuccess": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "failure": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "success": { "$ref": "primitives.schema.json#/$defs/SaveOutcome" }
      },
      "required": ["pattern", "save"],
      "additionalProperties": false
    },
    "HealingPatternBlock": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "trigger": { "$ref": "primitives.schema.json#/$defs/Trigger" },
        "target": { "$ref": "primitives.schema.json#/$defs/TargetSpec" },
        "scaling": { "$ref": "primitives.schema.json#/$defs/ScalingEntry" },
        "text": { "type": "string" },
        "reliable": { "type": "boolean" },
        "upcast": { "$ref": "primitives.schema.json#/$defs/UpcastSpec" },
        "downcast": { "$ref": "primitives.schema.json#/$defs/DowncastSpec" },
        "repeat": { "$ref": "primitives.schema.json#/$defs/RepeatSpec" },
        "pattern": { "type": "string", "const": "healing" },
        "healing": { "$ref": "primitives.schema.json#/$defs/HealingEntry" },
        "payloads": { "$ref": "primitives.schema.json#/$defs/PayloadList" }
      },
      "required": ["pattern", "healing"],
      "additionalProperties": false
    },
    "AutomaticPatternBlock": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "trigger": { "$ref": "primitives.schema.json#/$defs/Trigger" },
        "target": { "$ref": "primitives.schema.json#/$defs/TargetSpec" },
        "scaling": { "$ref": "primitives.schema.json#/$defs/ScalingEntry" },
        "text": { "type": "string" },
        "reliable": { "type": "boolean" },
        "upcast": { "$ref": "primitives.schema.json#/$defs/UpcastSpec" },
        "downcast": { "$ref": "primitives.schema.json#/$defs/DowncastSpec" },
        "repeat": { "$ref": "primitives.schema.json#/$defs/RepeatSpec" },
        "pattern": { "type": "string", "const": "automatic" },
        "payloads": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "damage": { "$ref": "primitives.schema.json#/$defs/PayloadList" },
        "dice": {
          "anyOf": [
            { "$ref": "primitives.schema.json#/$defs/DiceFormula" },
            { "type": "string" }
          ]
        }
      },
      "required": ["pattern"],
      "additionalProperties": false
    },
    "AuraPatternBlock": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "pattern": { "type": "string", "const": "aura" },
        "trigger": { "$ref": "primitives.schema.json#/$defs/Trigger" },
        "target": { "$ref": "primitives.schema.json#/$defs/TargetSpec" },
        "move": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["action", "bonus_action", "free_action"] },
            "distance": { "$ref": "primitives.schema.json#/$defs/NumberOrExpression" }
          },
          "additionalProperties": false
        },
        "text": { "type": "string" },
        "obscured": { "type": "boolean" },
        "difficultTerrain": { "type": "boolean" },
        "payloads": { "$ref": "primitives.schema.json#/$defs/PayloadList" }
      },
      "required": ["pattern", "target"],
      "additionalProperties": false
    },
    "SinglePatternBlock": {
      "anyOf": [
        { "$ref": "#/$defs/AttackPatternBlock" },
        { "$ref": "#/$defs/SavePatternBlock" },
        { "$ref": "#/$defs/HealingPatternBlock" },
        { "$ref": "#/$defs/AutomaticPatternBlock" },
        { "$ref": "#/$defs/AuraPatternBlock" }
      ]
    },
    "MultiBlockMechanic": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "trigger": { "$ref": "primitives.schema.json#/$defs/Trigger" },
        "text": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["succession", "sequence", "choice"],
          "default": "succession"
        },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/SinglePatternBlock" },
          "minItems": 0
        },
        "reliable": { "type": "boolean" },
        "upcast": { "$ref": "primitives.schema.json#/$defs/UpcastSpec" },
        "downcast": { "$ref": "primitives.schema.json#/$defs/DowncastSpec" },
        "repeat": { "$ref": "primitives.schema.json#/$defs/RepeatSpec" }
      },
      "required": ["blocks"],
      "additionalProperties": false
    }
  }
}
