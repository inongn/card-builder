{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "primitives.schema.json",
  "title": "Activity Mechanic Primitives",
  "description": "Reusable JSON Schema primitive definitions for D&D 5e / custom RPG activity mechanics.",
  "$defs": {
    "NumberOrExpression": {
      "anyOf": [
        { "type": "number" },
        { "type": "string" }
      ]
    },
    "DiceFormula": {
      "type": "object",
      "properties": {
        "count": { "$ref": "#/$defs/NumberOrExpression" },
        "sides": { "$ref": "#/$defs/NumberOrExpression" },
        "bonus": { "$ref": "#/$defs/NumberOrExpression" },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RollModifierFormula": {
      "type": "object",
      "properties": {
        "count": { "$ref": "#/$defs/NumberOrExpression" },
        "sides": { "$ref": "#/$defs/NumberOrExpression" },
        "bonus": { "$ref": "#/$defs/NumberOrExpression" },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DamageEntry": {
      "type": "object",
      "properties": {
        "dice": {
          "anyOf": [
            { "$ref": "#/$defs/DiceFormula" },
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "$ref": "#/$defs/DiceFormula" },
                  { "type": "string" }
                ]
              }
            }
          ]
        },
        "type": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "min": { "$ref": "#/$defs/NumberOrExpression" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "HealingEntry": {
      "type": "object",
      "properties": {
        "dice": {
          "anyOf": [
            { "$ref": "#/$defs/DiceFormula" },
            { "type": "string" },
            { "type": "number" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "$ref": "#/$defs/DiceFormula" },
                  { "type": "string" },
                  { "type": "number" }
                ]
              }
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["hitPoints", "tempHitPoints"]
        },
        "pool": {
          "anyOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/NumberOrExpression" }
          ]
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TargetSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "inherit": {
          "type": "string",
          "enum": ["prev_step", "trigger"]
        },
        "count": { "$ref": "#/$defs/NumberOrExpression" },
        "aoe": {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string"
            },
            "size": { "$ref": "#/$defs/NumberOrExpression" },
            "height": { "$ref": "#/$defs/NumberOrExpression" }
          },
          "required": ["shape", "size"],
          "additionalProperties": false
        },
        "range": { "$ref": "#/$defs/NumberOrExpression" },
        "filter": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AttackSpec": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "bonus": { "$ref": "#/$defs/NumberOrExpression" }
      },
      "additionalProperties": false
    },
    "TriggerEventEnum": {
      "type": "string",
      "enum": [
        "make_attack",
        "hit_with_attack",
        "miss_with_attack",
        "be_hit",
        "take_damage",
        "make_save",
        "fail_save",
        "make_check",
        "fail_check",
        "roll_initiative",
        "roll_damage",
        "land_crit",
        "drop_enemy_zero",
        "cast_spell",
        "on_cast",
        "enter_area",
        "start_turn",
        "end_turn",
        "leave_area",
        "move_within_range",
        "area_moves_into_space",
        "move_into_space",
        "custom"
      ]
    },
    "TriggerSpec": {
      "type": "object",
      "properties": {
        "event": {
          "anyOf": [
            { "$ref": "#/$defs/TriggerEventEnum" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/TriggerEventEnum" }
            }
          ]
        },
        "attackFilter": { "$ref": "#/$defs/AttackSpec" },
        "saveFilter": {
          "type": "object",
          "properties": {
            "ability": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": { "type": "string" }
                }
              ]
            },
            "dc": { "$ref": "#/$defs/NumberOrExpression" },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        "checkFilter": {
          "type": "object",
          "properties": {
            "ability": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": { "type": "string" }
                }
              ]
            },
            "skill": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": { "type": "string" }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "damageFilter": {
          "type": "object",
          "properties": {
            "damageType": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": { "type": "string" }
                }
              ]
            },
            "classification": { "type": "string" }
          },
          "additionalProperties": false
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Trigger": {
      "anyOf": [
        { "type": "string" },
        { "$ref": "#/$defs/TriggerSpec" }
      ]
    },
    "SaveSuccessOutcome": {
      "type": "object",
      "properties": {
        "halfDamage": { "type": "boolean" },
        "endOnSuccess": { "type": "boolean" },
        "payloads": { "$ref": "#/$defs/PayloadList" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SaveOutcome": {
      "anyOf": [
        { "$ref": "#/$defs/PayloadList" },
        { "$ref": "#/$defs/SaveSuccessOutcome" }
      ]
    },
    "SaveSpec": {
      "type": "object",
      "properties": {
        "ability": {
          "type": "string"
        },
        "dc": { "$ref": "#/$defs/NumberOrExpression" }
      },
      "additionalProperties": false
    },
    "ScalingEntry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "base": { "$ref": "#/$defs/NumberOrExpression" },
        "damageBonus": {
          "anyOf": [
            { "$ref": "#/$defs/DiceFormula" },
            { "type": "string" }
          ]
        },
        "countBonus": { "$ref": "#/$defs/NumberOrExpression" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ConditionEnum": {
      "type": "string",
      "enum": [
        "blinded",
        "charmed",
        "deafened",
        "exhaustion",
        "frightened",
        "grappled",
        "incapacitated",
        "invisible",
        "paralyzed",
        "petrified",
        "poisoned",
        "prone",
        "restrained",
        "stunned",
        "unconscious"
      ]
    },
    "DamagePayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "damage" },
        "dice": {
          "anyOf": [
            { "$ref": "#/$defs/DiceFormula" },
            { "type": "string" },
            { "type": "number" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "$ref": "#/$defs/DiceFormula" },
                  { "type": "string" },
                  { "type": "number" }
                ]
              }
            }
          ]
        },
        "damageType": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "min": { "$ref": "#/$defs/NumberOrExpression" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ConditionPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "condition" },
        "condition": {
          "anyOf": [
            { "$ref": "#/$defs/ConditionEnum" },
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "$ref": "#/$defs/ConditionEnum" },
                  { "type": "string" }
                ]
              }
            }
          ]
        },
        "end": { "$ref": "#/$defs/EndSpec" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TargetRollEnum": {
      "type": "string",
      "enum": [
        "attack",
        "check",
        "save",
        "dmg",
        "trigger"
      ]
    },
    "RollModifierPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "rollModifier" },
        "modifierType": {
          "type": "string",
          "enum": [
            "advantage",
            "disadvantage",
            "add",
            "subtract",
            "reroll",
            "attacksAgainstAdvantage",
            "attacksAgainstDisadvantage"
          ]
        },
        "targetRolls": {
          "anyOf": [
            { "$ref": "#/$defs/TargetRollEnum" },
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "$ref": "#/$defs/TargetRollEnum" },
                  { "type": "string" }
                ]
              }
            }
          ]
        },
        "dice": {
          "anyOf": [
            { "$ref": "#/$defs/RollModifierFormula" },
            { "$ref": "#/$defs/DiceFormula" },
            { "type": "string" }
          ]
        },
        "formula": {
          "anyOf": [
            { "$ref": "#/$defs/RollModifierFormula" },
            { "$ref": "#/$defs/DiceFormula" },
            { "type": "string" }
          ]
        },
        "saveFilter": {
          "type": "object",
          "properties": {
            "ability": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": { "type": "string" }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "text": { "type": "string" },
        "end": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "text": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ActionPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "action" },
        "actionType": {
          "type": "string",
          "enum": ["attack", "castSpell", "takeAction", "general"]
        },
        "attackFilter": { "$ref": "#/$defs/AttackSpec" },
        "spellFilter": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "school": { "type": "string" },
            "level": { "$ref": "#/$defs/NumberOrExpression" }
          },
          "additionalProperties": false
        },
        "count": { "$ref": "#/$defs/NumberOrExpression" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TransformPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "transform" },
        "statblock": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SummonPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "summon" },
        "statblock": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "StatModifierPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "statModifier" },
        "stat": { "type": "string" },
        "value": {
          "anyOf": [
            { "$ref": "#/$defs/NumberOrExpression" },
            { "$ref": "#/$defs/DiceFormula" }
          ]
        },
        "operation": {
          "type": "string",
          "enum": ["add", "subtract", "set", "multiply"],
          "default": "add"
        },
        "end": { "$ref": "#/$defs/EndSpec" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MovementPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "movement" },
        "movementType": {
          "type": "string",
          "enum": ["forced", "allow"]
        },
        "direction": {
          "type": "string",
          "enum": ["push", "pull", "any"]
        },
        "distance": {
          "anyOf": [
            { "$ref": "#/$defs/NumberOrExpression" },
            { "type": "string" }
          ]
        },
        "provokesOpportunityAttacks": { "type": "boolean" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TextPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "text" },
        "text": { "type": "string" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "HealingPayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "healing" },
        "healing": { "$ref": "#/$defs/HealingEntry" }
      },
      "required": ["type", "healing"],
      "additionalProperties": false
    },
    "ChoicePayloadOption": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "text": { "type": "string" },
        "payloads": { "$ref": "#/$defs/PayloadList" }
      },
      "additionalProperties": false
    },
    "ChoicePayload": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "choice" },
        "text": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChoicePayloadOption" },
          "minItems": 1
        }
      },
      "required": ["type", "options"],
      "additionalProperties": false
    },
    "Payload": {
      "anyOf": [
        { "$ref": "#/$defs/DamagePayload" },
        { "$ref": "#/$defs/ConditionPayload" },
        { "$ref": "#/$defs/RollModifierPayload" },
        { "$ref": "#/$defs/ActionPayload" },
        { "$ref": "#/$defs/TransformPayload" },
        { "$ref": "#/$defs/SummonPayload" },
        { "$ref": "#/$defs/StatModifierPayload" },
        { "$ref": "#/$defs/MovementPayload" },
        { "$ref": "#/$defs/HealingPayload" },
        { "$ref": "#/$defs/TextPayload" },
        { "$ref": "#/$defs/ChoicePayload" },
        { "$ref": "#/$defs/DamageEntry" },
        { "type": "string" }
      ]
    },
    "PayloadList": {
      "anyOf": [
        { "$ref": "#/$defs/Payload" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/Payload" }
        }
      ]
    },
    "UpcastSpec": {
      "type": "object",
      "properties": {
        "resourceStep": { "$ref": "#/$defs/NumberOrExpression" },
        "modifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "add": { "$ref": "#/$defs/NumberOrExpression" }
            },
            "required": ["path", "add"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "DowncastSpec": {
      "type": "object",
      "properties": {
        "condition": { "type": "string" },
        "modifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "replace": { "$ref": "#/$defs/NumberOrExpression" },
              "add": { "$ref": "#/$defs/NumberOrExpression" }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "RepeatSpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["action", "bonus_action", "free_action", "reaction"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "string",
          "enum": ["action", "bonus_action", "free_action", "reaction"]
        }
      ]
    },
    "EndSpec": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "take_damage",
            "repeat_save_on_damage",
            "action_check",
            "turn_repeat_save",
            "end_of_next_turn",
            "end_of_your_next_turn",
            "end_of_its_next_turn"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
